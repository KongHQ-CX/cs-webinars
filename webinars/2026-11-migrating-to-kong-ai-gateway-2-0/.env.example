# Variables the runbook (migration-runbook.html, step 2) and smoke-test.sh read.
# Copy to .env, replace every __REPLACE_ME__, then: set -a; source .env; set +a
# The runbook page generates the same exports from the settings you type into it.

# Konnect region API address: https://us.api.konghq.com (or eu, au, me, in, sg)
KONNECT_ADDR=https://us.api.konghq.com
# Konnect personal access token
KONNECT_PAT='__REPLACE_ME__'
KONGCTL_DEFAULT_KONNECT_PAT="$KONNECT_PAT"
KONGCTL_DEFAULT_KONNECT_BASE_URL="$KONNECT_ADDR"

# Name of your existing Kong Gateway 3.x control plane, and of your existing Kong AI Gateway 2.x
SRC_CP='__REPLACE_ME__'
TARGET_GW='__REPLACE_ME__'
# Proxy URLs of the two data planes, for example https://ai-316.example.com and https://ai.example.com
SRC_URL='__REPLACE_ME__'
DST_URL='__REPLACE_ME__'

# Provider credentials as full header values: "Bearer " followed by the key
DECK_OPENAI_AUTH='Bearer __REPLACE_ME__'
DECK_BEDROCK_AUTH='Bearer __REPLACE_ME__'
# Vertex AI: the service-account key as one line of JSON, for example DECK_GCP_SA_JSON="$(jq -c . key.json)"
DECK_GCP_SA_JSON='__REPLACE_ME__'
# Your GCP project ID and Vertex AI region
DECK_GCP_PROJECT='__REPLACE_ME__'
DECK_GCP_LOCATION=us-central1

# Application API keys: any random strings, for example key-$(openssl rand -hex 16)
DECK_KEY_APP_REPORTING='__REPLACE_ME__'
DECK_KEY_APP_CHATBOT='__REPLACE_ME__'
DECK_KEY_APP_BATCH='__REPLACE_ME__'
DECK_KEY_APP_ETL='__REPLACE_ME__'
