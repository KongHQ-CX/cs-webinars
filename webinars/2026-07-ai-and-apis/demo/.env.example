# Copy to .env and fill in. Read by the Python scripts.

# --- LLM (OpenAI) ---
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o

# --- The API through Kong (stages 2-3, REST) ---
API_BASE_URL=http://localhost:8000/api

# --- Kong Konnect (Stage 6) ---
# Personal access token from https://cloud.konghq.com  (Konnect > PAT)
KONNECT_TOKEN=kpat_...
# Control plane name you create in Konnect (the quickstart makes "quickstart")
KONNECT_CONTROL_PLANE=quickstart

# --- Keycloak (Stage 6 OAuth) ---
# One issuer URL that resolves the SAME from your host and from the Kong data
# plane container. Easiest: add "127.0.0.1 host.docker.internal" to /etc/hosts,
# then this works everywhere.
KEYCLOAK_ISSUER=http://host.docker.internal:8081/realms/mcp
# Confidential client the OpenAI agent uses for a client-credentials token.
KC_CLIENT_ID=mcp-kong
KC_CLIENT_SECRET=mcp-kong-secret

# --- The generated MCP endpoint Kong serves ---
MCP_URL=http://localhost:8000/mcp

# --- Rate limit applied to the MCP route (requests/minute) ---
RATE_LIMIT_PER_MIN=10

# --- Token exchange (RFC 8693) demo ---
KC_TARGET_AUDIENCE=inventory-api
KC_DEMO_USER=demo
KC_DEMO_PASS=demo
# Optional: request a narrower scope on the exchanged token to show downscoping.
KC_EXCHANGE_SCOPE=

# --- Kong Konnect data plane (docker-compose.yml) ---
# From Konnect: Gateway Manager > <control plane> > + New Data Plane Node.
# (Values below are examples — replace with your control plane's.)
KONNECT_CP_ENDPOINT=dc85c1a175.us.cp.konghq.com:443
KONNECT_CP_SERVER_NAME=dc85c1a175.us.cp.konghq.com
KONNECT_TP_ENDPOINT=dc85c1a175.us.tp.konghq.com:443
KONNECT_TP_SERVER_NAME=dc85c1a175.us.tp.konghq.com
