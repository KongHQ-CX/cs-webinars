# Variables the scripts in this folder read. Every value is yours to supply.
# Replace each __REPLACE_ME__, then load the file in the shell you run the scripts from:
#   cp .env.example .env
#   set -a; . ./.env; set +a
# tutorial/01-set-up-konnect.md explains where each value comes from. README.md lists the format each stage expects.
# A script stops and names any variable that is unset, empty or still __REPLACE_ME__.
#
# TOKENS DO NOT GO IN THIS FILE. Enter each one in your shell, so it never reaches a file or your history:
#   read -rs ZONE_TOKEN; export ZONE_TOKEN
#   read -rs OPERATOR_TOKEN; export OPERATOR_TOKEN
#   read -rs CLOUDFLARE_API_TOKEN; export CLOUDFLARE_API_TOKEN    # optional HTTPS only
# .env is listed in .gitignore. It still holds your account ids and image paths, so keep it private.

# From Konnect (tutorial step 1)
KONNECT_CP_ID=__REPLACE_ME__
MESH_NAME=__REPLACE_ME__
KDS_GLOBAL_ADDRESS=__REPLACE_ME__      # grpcs://<region>.mesh.sync.konghq.com:443
GATEWAY_CP_ID=__REPLACE_ME__           # a UUID
KONNECT_SERVER_URL=__REPLACE_ME__      # <geo>.api.konghq.com, geo us, eu, au, me or in

# Images, each pinned by digest
DEMO_IMAGE=__REPLACE_ME__              # the demo app image you pushed, ending in @sha256:<64 hex>
GATEWAY_IMAGE=__REPLACE_ME__           # <name>:<tag>@sha256:<64 hex>, tag pinned to a patch version

# Per cluster
ZONE_NAME=__REPLACE_ME__               # the zone this cluster reports, different on each cluster
LOCAL_ZONE=__REPLACE_ME__              # stage 07
REMOTE_ZONE=__REPLACE_ME__             # stage 07
PEER_NAT_IPS=__REPLACE_ME__            # the other cluster's NAT addresses, set per zone install
GATEWAY_SPIFFE_ID=__REPLACE_ME__       # spiffe://<trust domain>/ns/kong/sa/<ServiceAccount>

# Optional: HTTPS for the gateway
DNS_NAME=__REPLACE_ME__
DNS_ZONE=__REPLACE_ME__
TLS_EMAIL=__REPLACE_ME__
