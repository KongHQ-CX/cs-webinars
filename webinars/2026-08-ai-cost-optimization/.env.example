# ==============================================================================
# ENVIRONMENT VARIABLES FOR KONG AI GATEWAY COST OPTIMIZATION WEBINAR
# ==============================================================================
# Instructions:
# 1. Copy this file to .env:
#    cp .env.example .env
# 2. Populate your actual credentials in .env
# 3. Source the variables in your active terminal:
#    source .env
# ==============================================================================

# 1. OpenAI API Credentials
export DECK_OPENAI_API_KEY="sk-your-openai-api-key-here"

# 2. Webinar Consumer Security Key (API Key Authentication)
export DECK_WEBINAR_API_KEY="__REPLACE_ME__"

# 2. Kong Konnect Control Plane Sync Credentials (for decK sync)
export DECK_KONNECT_TOKEN="kpat_your-konnect-token-here"
export DECK_KONNECT_ADDR="https://us.api.konghq.com"
export DECK_CP_NAME="ai-cost-optimization"

# 3. Redis Credentials (Required for Semantic Cache & Token Rate Limiting)
export DECK_REDIS_HOST="redis-stack.ai-gateway.svc.cluster.local"
export DECK_REDIS_PORT="6379"

# 4. Prompt Compressor Service Target URL
export DECK_COMPRESSOR_URL="http://your-llmlingua-compressor.namespace.svc.cluster.local:8080"

# 5. Kong Gateway Data Plane Target URL
export KONG_PROXY_URL="http://localhost:8000"
# Or if you are running over the public ingress:
# export KONG_PROXY_URL="https://ai-costs-webinar.kong.salakhutdinov.com"

# 5. Kubernetes Data Plane Coordinates (for streaming log tests)
export K8S_NAMESPACE="kong-konnect-dp"
export K8S_DEPLOYMENT="deployment/ai-costs-webinar-dp-kong"
